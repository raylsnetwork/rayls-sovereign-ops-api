DATABASE_CONNECTIONSTRING=host=localhost port=5432 user=postgres password=postgres dbname=ops_api
LOGGING=development
CORSURLS=http://localhost:3000
BASE_URL=http://localhost:8080
# Frontend URL to redirect to after successful OAuth login (leave blank to return JSON)
POST_LOGIN_REDIRECT_URL=http://localhost:3000

# Auth
JWT_SECRET=your-secret-key
SECURE_COOKIES=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Admin user email. A login (Google, Microsoft, or standalone email) whose email
# matches gets an is_admin claim in the JWT, gating admin-only actions. Empty = no admin.
OPS_ADMIN_EMAIL=
# Standalone email sign-up (POST /auth/signup). LOCAL DEV ONLY: there is no verification
# code yet, so it issues a valid session to whoever submits an address — including the
# admin's. Leave false anywhere reachable from outside; the endpoint 404s while off.
EMAIL_SIGNUP_ENABLED=false

# Custody (leave blank to use self-custody stub — for local dev only)
CUSTODY_RAYLS_HSM_URL=
CUSTODY_RAYLS_HSM_API_KEY=
CUSTODY_RAYLS_HSM_PASSWORD=

# Blockchain / on-chain role assignment (leave blank to disable — uses no-op in local dev)
BLOCKCHAIN_RPC_URL=
DEPLOYMENT_PROXY_REGISTRY_ADDR=

# DEV-ONLY privileged keys (leave blank in production — role assignment/funding stays out of band):
#   BLOCKCHAIN_FAUCET_PRIVATE_KEY funds new custody wallets for gas on non-gasless chains.
#   BLOCKCHAIN_ROLE_GRANTOR_PRIVATE_KEY signs grantRole to give new wallets FACTORY_DEPLOYER so
#   users can deploy tokens; must hold admin authority over FACTORY_DEPLOYER. Defaults to the
#   faucet key when blank.
BLOCKCHAIN_FAUCET_PRIVATE_KEY=
BLOCKCHAIN_ROLE_GRANTOR_PRIVATE_KEY=

# Runtime mode: privacy_node | hub
RAYLS_MODE=privacy_node

# Privacy Node
PN_RPC_URL=http://localhost:8545
TOKEN_REGISTRY_ADDRESS=
PN_BLOCK_RANGE=100
PN_POLL_INTERVAL=2s

# Blockscout (direct DB connection for LISTEN/NOTIFY + backfill)
BLOCKSCOUT_DB_CONN=host=localhost port=5433 user=blockscout password=blockscout dbname=blockscout
BLOCKSCOUT_BACKFILL_BATCH=50

# Hub mode
HUB_CONTRACT_ADDRESS=
HUB_DECRYPTION_KEY=

# NATS JetStream
NATS_URL=nats://localhost:4222

BLOCKCHAIN_STARTING_BLOCK=

# Public Chain Configuration
PUBLIC_CHAIN_CHAIN_ID=7331
