# Local dev config for the ops-service + playground stack (start_dev.sh).
#
# This drives a MINIMAL stack: the ops-service + playground on top of a local RayUp
# control plane. No hub, no relayer/cts/gnark. The chain is created on demand from the
# playground and RayUp provisions it (with its own ops-api, contracts and explorer).
#
# start_dev.sh copies this file to docker/development/rayup.env on first run and fills in
# the chain's RPC/chainId (and a generated PRIVATE_KEY_SYSTEM) once a chain is provisioned.

# --- Chain (filled in by RayUp on provisioning) --------------------------------
# Left blank: the chain does not exist until you create one from the playground; RayUp
# writes its RPC URL / chainId here after provisioning.
PRIVACY_NODE_RPC_URL=
PRIVACY_NODE_CHAIN_ID=

# Required by the contracts deploy even in hubless mode (no public-chain tx is sent
# during the core deploy, so any valid chain id works).
PUBLIC_CHAIN_ID=1337

# --- Deploy key (auto-generated) ----------------------------------------------
# Per-developer key so concurrent deploys don't collide on nonce. Left blank here;
# start_dev.sh fills it via `cast wallet new`. RayUp axyl chains are feeless, so the key
# needs no funding.
PRIVATE_KEY_SYSTEM=

# --- Deployed contracts (cache) -----------------------------------------------
# Filled by start_dev.sh after a successful deploy. Delete the line (or run with
# --redeploy) to force a fresh deploy.
DEPLOYMENT_PROXY_REGISTRY_ADDR=

# Block where the contracts were deployed — the AccessManager indexer starts here
# instead of block 0. Set by start_dev.sh.
BLOCKCHAIN_STARTING_BLOCK=

# Set to 1 by start_dev.sh after it registers the business roles (BANK_EMPLOYEE,
# PRIVACY_NODE_OPERATOR, AUDITOR, COMPLIANCE_OFFICER) on the AccessManager. Cleared on
# a fresh deploy so they get re-activated on the new contracts.
BUSINESS_ROLES_ACTIVATED=

# --- Admin bootstrap (login) ---------------------------------------------------
# Email of the admin to create via POST /admin/bootstrap. Leave blank to skip bootstrap.
OPS_ADMIN_EMAIL=

# --- Optional ------------------------------------------------------------------
# WalletConnect project id for the playground (optional).
WALLETCONNECT_PROJECT_ID=

# Blockscout DB connection for the token/balance indexer (worker). Leave blank and
# start_dev.sh points it at the shared Blockscout DB automatically. Set it only to override.
BLOCKSCOUT_DB_CONN=
