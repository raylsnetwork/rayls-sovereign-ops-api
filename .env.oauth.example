# OAuth credentials for the playground login (Google / Microsoft).
#
# start_dev.sh sources this (if present in the repo root) and injects the values
# into the ops-api container. If absent, it falls back to
# ../rayls-sovereign-relayer/.env.oauth, so if you already have it there you
# don't need to copy it. Without any of them, OAuth login is disabled (SIWE still works).
#
# Copy to `.env.oauth` (gitignored) and fill in.
#
# IMPORTANT: the OAuth client's authorized redirect URI must include this stack's
# callback. ops-api runs on http://localhost:8080, so add (Google console):
#   http://localhost:8080/auth/google/callback
# (the relayer used :8780 — a different port needs its own redirect URI registered).

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional: admin email for POST /admin/bootstrap (or pass --bootstrap-email).
OPS_ADMIN_EMAIL=
